# Скопируй этот файл в .env и впиши свои ключи. Файл .env никому не показывай!

# Токен бота от @BotFather
BOT_TOKEN=

# Ключ с console.groq.com (распознавание речи + выбор моментов)
GROQ_API_KEY=

# Нейросеть для выбора моментов. По умолчанию Groq; можно поменять на DeepSeek/OpenRouter
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# Твой Telegram ID (узнать у @userinfobot) — для тебя не будет лимитов
ADMIN_IDS=

# Сколько видео в день бесплатно одному человеку (0 — без лимита)
DAILY_LIMIT=3
# Максимальная длина исходного видео в минутах
MAX_VIDEO_MIN=90

# Ширина шортса: 720 (быстрее) или 1080 (качественнее)
RESOLUTION=720
# Длина шортса в секундах
CLIP_MIN_SEC=20
CLIP_MAX_SEC=60

# Кодировщик: libx264 (процессор) или h264_nvenc (видеокарта NVIDIA — в разы быстрее)
VIDEO_ENCODER=libx264
# Шрифт субтитров (должен поддерживать кириллицу)
SUB_FONT=Arial

# Свой Local Bot API Server для файлов до 2 ГБ, например http://localhost:8081
BOT_API_URL=
# Только если сервер в Docker: папка файлов внутри контейнера и где она на компьютере
# BOT_API_SERVER_DIR=/var/lib/telegram-bot-api
# BOT_API_LOCAL_DIR=C:\telegram-bot-api
