# Скопируй этот файл в .env и впиши свои ключи. Файл .env никому не показывай!

# Токен бота от @BotFather
BOT_TOKEN=

# Ключ с console.groq.com (распознавание речи + выбор моментов)
GROQ_API_KEY=

# Нейросеть для выбора моментов. По умолчанию Groq; можно поменять на DeepSeek/OpenRouter
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# Твой Telegram ID (узнать у @userinfobot) — для тебя не будет лимитов
ADMIN_IDS=

# --- Лимиты и Премиум ---
# Бесплатно: сколько фрагментов по своим таймингам в день
FREE_FRAGMENTS_PER_DAY=5
# Премиум: фрагментов в день (0 — без лимита) и авто-нарезок в день
PREMIUM_FRAGMENTS_PER_DAY=0
PREMIUM_AUTO_PER_DAY=5
# Сколько дней Премиума за друга, который сделал первую нарезку
REF_PREMIUM_DAYS=3
# Первые N пользователей получают подарок — дни Премиума (0 дней — выключено)
FOUNDERS_LIMIT=300
FOUNDERS_PREMIUM_DAYS=7
# Приглашённый другом получает +фрагменты на первые сутки
REF_FRIEND_BONUS=5
# +фрагментов в день тем, кто сам включил водяной знак с ботом (0 — выключено)
WATERMARK_BONUS=3
# Напоминание «лимит обновился» (тем, кто включил): с какого часа слать и часовой пояс от UTC
REMIND_HOUR=10
TZ_OFFSET=6

# Тарифы: дней:цена через запятую
PREMIUM_PLANS=7:149,30:399
PRICE_CURRENCY=₽
# Способ оплаты. Пусто — заглушка (кнопка «Купить» есть, но оплата «скоро»)
PAYMENT_PROVIDER=

# Окно разметки таймингов (GitHub Pages). Пусто — тайминги вводятся только в чате
WEBAPP_URL=

# Файл базы данных (пользователи, премиум, лимиты, рефералы)
DB_PATH=bot.db

# Максимальная длина исходного видео в минутах
MAX_VIDEO_MIN=90

# Ширина шортса: 720 (быстрее) или 1080 (качественнее)
RESOLUTION=720
# Длина шортса в секундах
CLIP_MIN_SEC=20
CLIP_MAX_SEC=60

# Кодировщик: libx264 (процессор) или h264_nvenc (видеокарта NVIDIA — в разы быстрее)
VIDEO_ENCODER=libx264
# Шрифты субтитров лежат в папке fonts/ проекта (Inter, с кириллицей)
# Своя модель лица для «Обрезки» (обычно не нужна — встроена в OpenCV)
# FACE_CASCADE=

# Свой Local Bot API Server для файлов до 2 ГБ, например http://localhost:8081
BOT_API_URL=
# Только если сервер в Docker: папка файлов внутри контейнера и где она на компьютере
# BOT_API_SERVER_DIR=/var/lib/telegram-bot-api
# BOT_API_LOCAL_DIR=C:\telegram-bot-api
